# Opt-in live suite (`yarn test:live`) against the Assinafy sandbox, and the end-to-end suite (`yarn test:e2e`), whose
# simulator forwards to the sandbox. Copy to .env (ignored by git). Neither suite calls Assinafy anywhere but the sandbox.
ASSINAFY_SANDBOX_API_KEY=
ASSINAFY_SANDBOX_ACCOUNT_ID=
# Live suite only: an inbox you control that may receive sandbox signature invitations.
ASSINAFY_LIVE_SIGNER_EMAIL=
# Optional: a ready sandbox template with signer (and optionally editor) roles. The end-to-end suite needs exactly one
# signer role; the live suite also accepts several when the sandbox accepts @example.invalid signers.
ASSINAFY_LIVE_TEMPLATE_ID=
# Optional (live suite): a sandbox document that is already certificated, to exercise signed-file retrieval.
ASSINAFY_LIVE_SIGNED_DOCUMENT_ID=
# Not read from this file (set in the shell): TWENTY_USER_ACCESS_TOKEN, the seeded admin's access token of the local
# test container, for `yarn test:integration` and `yarn test:e2e`; E2E_KEEP_INSTALLED=1 keeps the end-to-end build.
